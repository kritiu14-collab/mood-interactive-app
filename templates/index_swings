<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solace | Mood Swings 🎢</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* ── INSIDE OUT: HAPPY = GOLDEN YELLOW ── */
        :root {
            --mood-primary:   #4CC9BE;
            --mood-secondary: #2A9D8F;
            --mood-light:     #E8FAF8;
            --mood-dark:      #1a3c38;
            --mood-card-bg:   #FFFDF0;
            --mood-border:    #A8E6E1;
            --mood-btn:       #FFD700;
            --mood-btn-text:  #1a3c38;
            --mood-hero-from: #4CC9BE;
            --mood-hero-to:   #2A9D8F;
            --mood-nav-bg:    #0d2420;
            --mood-footer-bg: #0d2420;
        }

        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap');

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Nunito', 'Segoe UI', sans-serif;
            background: var(--mood-light);
            color: var(--mood-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* ── NAVBAR ── */
        .navbar {
            background: var(--mood-nav-bg) !important;
            padding: 12px 0;
            position: sticky; top: 0; z-index: 100;
        }

        .navbar-brand {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--mood-primary) !important;
            letter-spacing: -0.5px;
        }

        .nav-link {
            color: rgba(255,255,255,0.75) !important;
            font-weight: 600;
            font-size: 0.9rem;
            transition: color 0.2s;
        }
        .nav-link:hover { color: var(--mood-primary) !important; }

        .mood-badge-nav {
            background: var(--mood-primary);
            color: var(--mood-btn-text);
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        /* ── ACCOUNT BUTTON ── */
        .account-btn {
            width: 38px; height: 38px;
            border-radius: 50%;
            background: var(--mood-primary);
            border: none;
            cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
            color: var(--mood-btn-text);
            position: relative;
            transition: transform 0.2s;
        }
        .account-btn:hover { transform: scale(1.1); }

        /* ── ACCOUNT PANEL (slide-in from right) ── */
        .account-panel {
            position: fixed;
            top: 0; right: -420px;
            width: 400px; height: 100vh;
            background: white;
            box-shadow: -8px 0 40px rgba(0,0,0,0.15);
            z-index: 9999;
            transition: right 0.35s cubic-bezier(0.4,0,0.2,1);
            overflow-y: auto;
            display: flex; flex-direction: column;
        }
        .account-panel.open { right: 0; }

        .panel-overlay {
            position: fixed; inset: 0;
            background: rgba(0,0,0,0.4);
            z-index: 9998;
            display: none;
        }
        .panel-overlay.open { display: block; }

        .panel-header {
            background: linear-gradient(135deg, var(--mood-hero-from), var(--mood-hero-to));
            padding: 30px 24px 24px;
            color: var(--mood-btn-text);
        }

        .panel-avatar {
            width: 64px; height: 64px;
            border-radius: 50%;
            background: rgba(255,255,255,0.3);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.8rem;
            margin-bottom: 12px;
            border: 3px solid rgba(255,255,255,0.5);
        }

        .panel-username { font-size: 1.3rem; font-weight: 800; }
        .panel-email    { font-size: 0.82rem; opacity: 0.75; margin-top: 2px; }

        .panel-close {
            position: absolute; top: 16px; right: 16px;
            background: rgba(255,255,255,0.2);
            border: none; border-radius: 50%;
            width: 32px; height: 32px;
            color: var(--mood-btn-text);
            cursor: pointer; font-size: 1rem;
            display: flex; align-items: center; justify-content: center;
        }

        .panel-body { padding: 20px 24px; flex: 1; }

        .panel-section-title {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #aaa;
            font-weight: 700;
            margin: 18px 0 10px;
        }

        /* Stats row */
        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 10px;
            margin-bottom: 6px;
        }

        .stat-box {
            background: var(--mood-light);
            border-radius: 12px;
            padding: 12px 8px;
            text-align: center;
            border: 1px solid var(--mood-border);
        }
        .stat-box .num { font-size: 1.4rem; font-weight: 800; color: var(--mood-secondary); }
        .stat-box .lbl { font-size: 0.7rem; color: #888; margin-top: 2px; }

        /* Mood calendar */
        .mood-calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            margin-bottom: 8px;
        }

        .cal-day {
            aspect-ratio: 1;
            border-radius: 6px;
            display: flex; align-items: center; justify-content: center;
            font-size: 0.6rem;
            font-weight: 700;
            cursor: default;
            position: relative;
        }

        .cal-day.has-mood { cursor: pointer; }
        .cal-day.has-mood:hover::after {
            content: attr(data-mood);
            position: absolute;
            bottom: calc(100% + 4px);
            left: 50%; transform: translateX(-50%);
            background: #333; color: white;
            padding: 3px 7px; border-radius: 5px;
            font-size: 0.65rem; white-space: nowrap; z-index: 10;
        }

        /* Mood colors for calendar */
        .cal-empty  { background: #f5f5f5; }
        .cal-happy  { background: #FFD700; color: #4a3c00; }
        .cal-sad    { background: #4FC3F7; color: #01337a; }
        .cal-angry  { background: #EF5350; color: white; }
        .cal-anxious{ background: #AB47BC; color: white; }
        .cal-calm   { background: #66BB6A; color: #1b4332; }
        .cal-stressed{background: #FF7043; color: white; }
        .cal-tired  { background: #90A4AE; color: white; }
        .cal-fear   { background: #5C6BC0; color: white; }
        .cal-swings { background: linear-gradient(135deg,#FF7043,#AB47BC); color: white; }
        .cal-none   { background: #eeeeee; color: #bbb; }

        .cal-label-row {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 5px;
            margin-bottom: 5px;
        }
        .cal-label-row span {
            text-align: center;
            font-size: 0.6rem;
            color: #aaa;
            font-weight: 700;
        }

        /* Panel nav links */
        .panel-nav-link {
            display: flex; align-items: center; gap: 12px;
            padding: 11px 14px;
            border-radius: 10px;
            text-decoration: none;
            color: #333;
            font-weight: 600;
            font-size: 0.88rem;
            transition: background 0.15s;
            margin-bottom: 4px;
        }
        .panel-nav-link:hover { background: var(--mood-light); color: var(--mood-secondary); }
        .panel-nav-link i { width: 20px; text-align: center; color: var(--mood-secondary); }

        .panel-logout {
            padding: 16px 24px;
            border-top: 1px solid #f0f0f0;
        }

        .btn-logout {
            width: 100%;
            padding: 11px;
            border-radius: 10px;
            border: 1.5px solid #fee2e2;
            background: #fff5f5;
            color: #e53e3e;
            font-weight: 700;
            font-size: 0.88rem;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-logout:hover { background: #fed7d7; }

        /* Progress bar */
        .progress-bar-mood {
            height: 8px;
            border-radius: 4px;
            background: #f0f0f0;
            overflow: hidden;
            margin-bottom: 6px;
        }
        .progress-fill-mood {
            height: 100%;
            border-radius: 4px;
            background: linear-gradient(90deg, var(--mood-hero-from), var(--mood-hero-to));
            transition: width 0.6s ease;
        }

        /* ── HERO ── */
        .hero-section {
            background: linear-gradient(135deg, var(--mood-hero-from), var(--mood-hero-to));
            padding: 60px 0 80px;
            text-align: center;
            color: var(--mood-btn-text);
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute; inset: 0;
            background: radial-gradient(circle at 70% 50%, rgba(255,255,255,0.15), transparent 60%);
        }

        .hero-section h1 {
            font-size: 2.8rem;
            font-weight: 800;
            margin-bottom: 10px;
            position: relative;
        }

        .hero-section p.lead {
            font-size: 1.05rem;
            opacity: 0.85;
            max-width: 560px;
            margin: 0 auto;
            position: relative;
        }

        .hero-emoji {
            font-size: 4rem;
            margin-bottom: 16px;
            display: block;
            animation: bounce 2s ease-in-out infinite;
        }

        @keyframes bounce {
            0%,100% { transform: translateY(0); }
            50%      { transform: translateY(-10px); }
        }

        /* ── FEATURE CARDS ── */
        .features-section { padding: 50px 0 60px; }

        .feature-card {
            background: white;
            border: 1.5px solid var(--mood-border);
            border-radius: 20px;
            padding: 28px 22px;
            height: 100%;
            transition: all 0.3s ease;
            text-align: center;
        }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.1);
            border-color: var(--mood-primary);
        }

        .feature-icon {
            font-size: 2.4rem;
            margin-bottom: 14px;
            display: block;
        }

        .feature-card h5 {
            font-weight: 800;
            font-size: 1rem;
            margin-bottom: 8px;
            color: var(--mood-dark);
        }

        .feature-card p {
            font-size: 0.82rem;
            color: #777;
            margin-bottom: 14px;
            line-height: 1.5;
        }

        /* ── BUTTONS ── */
        .btn-mood {
            background: var(--mood-btn);
            color: var(--mood-btn-text);
            border: none;
            border-radius: 50px;
            padding: 9px 22px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-mood:hover { filter: brightness(0.92); transform: scale(1.03); color: var(--mood-btn-text); }

        .btn-mood-outline {
            background: transparent;
            color: var(--mood-secondary);
            border: 2px solid var(--mood-primary);
            border-radius: 50px;
            padding: 8px 20px;
            font-weight: 700;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }
        .btn-mood-outline:hover { background: var(--mood-primary); color: var(--mood-btn-text); }

        /* ── AI SECTION ── */
        .ai-section {
            background: linear-gradient(135deg, var(--mood-hero-from)22, var(--mood-hero-to)11);
            border: 2px solid var(--mood-border);
            border-radius: 24px;
            padding: 30px;
            margin: 10px 0 30px;
        }

        /* ── QUOTE BOX ── */
        .quote-box {
            background: white;
            border-left: 5px solid var(--mood-primary);
            border-radius: 0 16px 16px 0;
            padding: 20px 24px;
            margin-bottom: 30px;
            font-style: italic;
            font-size: 1.05rem;
            color: #555;
        }

        /* ── FOOTER ── */
        footer {
            background: var(--mood-footer-bg);
            color: rgba(255,255,255,0.6);
            padding: 30px 0;
            margin-top: auto;
            font-size: 0.82rem;
        }
    </style>
</head>
<body>

<!-- Account Panel Overlay -->
<div class="panel-overlay" id="panelOverlay" onclick="closePanel()"></div>

<!-- Account Panel -->
<div class="account-panel" id="accountPanel">
    <div class="panel-header">
        <button class="panel-close" onclick="closePanel()"><i class="fas fa-times"></i></button>
        <div class="panel-avatar">😊</div>
        <div class="panel-username" id="panelUsername">Loading...</div>
        <div class="panel-email"    id="panelEmail">—</div>
    </div>

    <div class="panel-body">

        <!-- Stats -->
        <div class="panel-section-title">Your Progress</div>
        <div class="stats-row">
            <div class="stat-box">
                <div class="num" id="statMoods">—</div>
                <div class="lbl">Mood Logs</div>
            </div>
            <div class="stat-box">
                <div class="num" id="statJournals">—</div>
                <div class="lbl">Journals</div>
            </div>
            <div class="stat-box">
                <div class="num" id="statDays">—</div>
                <div class="lbl">Days Active</div>
            </div>
        </div>

        <!-- Top mood progress -->
        <div class="panel-section-title">Top Mood This Week</div>
        <div style="font-size:0.82rem;color:#555;margin-bottom:6px">
            <span id="topMoodLabel">—</span>
        </div>
        <div class="progress-bar-mood">
            <div class="progress-fill-mood" id="topMoodBar" style="width:0%"></div>
        </div>

        <!-- Mood Calendar -->
        <div class="panel-section-title">Mood Calendar (Last 28 Days)</div>
        <div class="cal-label-row">
            <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span>
            <span>Thu</span><span>Fri</span><span>Sat</span>
        </div>
        <div class="mood-calendar" id="moodCalendar">
            <!-- filled by JS -->
        </div>

        <!-- Quick links -->
        <div class="panel-section-title">Quick Links</div>
        <a href="/history"   class="panel-nav-link"><i class="fas fa-chart-line"></i> Mood History</a>
        <a href="/journal"   class="panel-nav-link"><i class="fas fa-book-open"></i> My Journal</a>
        <a href="/todo"      class="panel-nav-link"><i class="fas fa-tasks"></i> My Tasks</a>
        <a href="/tracker"   class="panel-nav-link"><i class="fas fa-sync-alt"></i> Change Mood</a>
        <a href="/music"     class="panel-nav-link"><i class="fas fa-music"></i> Mood Music</a>
    </div>

    <div class="panel-logout">
        <button class="btn-logout" onclick="window.location.href='/logout'">
            <i class="fas fa-sign-out-alt me-2"></i> Log Out
        </button>
    </div>
</div>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand" href="/tracker">🎢 solace.</a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
            <i class="fas fa-bars text-white"></i>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto align-items-center gap-1">
                <li class="nav-item"><a class="nav-link" href="/ai_chat"><i class="fas fa-robot me-1"></i>AI Chat</a></li>
                <li class="nav-item"><a class="nav-link" href="/todo"><i class="fas fa-tasks me-1"></i>Tasks</a></li>
                <li class="nav-item"><a class="nav-link" href="/journal"><i class="fas fa-book me-1"></i>Journal</a></li>
                <li class="nav-item"><a class="nav-link" href="/music"><i class="fas fa-music me-1"></i>Music</a></li>
                <li class="nav-item"><a class="nav-link" href="/history"><i class="fas fa-chart-line me-1"></i>History</a></li>
                <li class="nav-item ms-2"><span class="mood-badge-nav">🎢 Grounding</span></li>
                <li class="nav-item ms-2">
                    <button class="account-btn" onclick="openPanel()" title="My Account">
                        <i class="fas fa-user"></i>
                    </button>
                </li>
            </ul>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero-section">
    <div class="container">
        <span class="hero-emoji">🎢</span>
        <h1>Let's find your centre., {{ username }}!</h1>
        <p class="lead">"You don't have to label every feeling. Just let it pass through."</p>
    </div>
</section>

<!-- QUOTE -->
<div class="container mt-4">
    <div class="quote-box" id="quoteBox">
        "You don't have to label every feeling. Just let it pass through."
    </div>
    <div class="text-end mb-4">
        <button class="btn-mood-outline btn-sm" onclick="newQuote()">
            <i class="fas fa-sync-alt me-1"></i> New Quote
        </button>
    </div>
</div>

<!-- FEATURES -->
<section class="features-section">
    <div class="container">
        <div class="row g-4">

            
            <div class="col-md-4 col-sm-6"><div class="feature-card"><span class="feature-icon">🤖</span><h5>Grounding AI</h5><p>Feeling everything at once? Let's untangle it gently.</p><a href="/ai_chat" class="btn-mood w-100">Talk to AI</a></div></div>
            <div class="col-md-4 col-sm-6"><div class="feature-card"><span class="feature-icon">🎵</span><h5>Balancing Sounds</h5><p>Steady teal-toned beats to anchor your energy.</p><a href="/music" class="btn-mood w-100">Play Music</a></div></div>
            <div class="col-md-4 col-sm-6"><div class="feature-card"><span class="feature-icon">✅</span><h5>Grounding Tasks</h5><p>Simple tasks to anchor you when emotions feel overwhelming.</p><a href="/todo" class="btn-mood w-100">View Tasks</a></div></div>
            <div class="col-md-4 col-sm-6"><div class="feature-card"><span class="feature-icon">📖</span><h5>Stream of Thoughts</h5><p>Write without a plan — whatever comes let it flow.</p><a href="/journal" class="btn-mood w-100">Open Journal</a></div></div>
            <div class="col-md-4 col-sm-6"><div class="feature-card"><span class="feature-icon">📊</span><h5>Mood Patterns</h5><p>Swings often have triggers. Your history can help reveal them.</p><a href="/history" class="btn-mood w-100">View History</a></div></div>
            <div class="col-md-4 col-sm-6"><div class="feature-card"><span class="feature-icon">🔄</span><h5>Change Mood</h5><p>Feeling more settled? Update your mood anytime.</p><a href="/tracker" class="btn-mood w-100">Update Mood</a></div></div>

        <!-- AI Section -->
        <div class="ai-section mt-4">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <span style="font-size:3rem">✨</span>
                </div>
                <div class="col">
                    <h5 class="fw-bold mb-1">Solace AI is here for you</h5>
                    <p class="mb-0 text-muted small">It's okay to feel multiple things at once. Let's sort through them gently — one emotion at a time.</p>
                </div>
                <div class="col-md-3">
                    <a href="/ai_chat" class="btn-mood w-100 text-center d-block py-2">Start Chat →</a>
                </div>
            </div>
        </div>

    </div>
</section>

<footer>
    <div class="container text-center">
        <p class="mb-0">solace. · Your Mood-Interactive Sanctuary &copy; 2026</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ── QUOTES ──
const quotes = [
    "You don't have to label every feeling. Just let it pass through.",
    "Emotions are visitors. Let them come, let them go.",
    "The ocean has waves but the depths are always still.",
    "Your feelings are valid, even when they contradict each other."
];
function newQuote() {
    document.getElementById('quoteBox').textContent =
        '"' + quotes[Math.floor(Math.random() * quotes.length)] + '"';
}

// ── ACCOUNT PANEL ──
function openPanel() {
    document.getElementById('accountPanel').classList.add('open');
    document.getElementById('panelOverlay').classList.add('open');
    loadAccountData();
}
function closePanel() {
    document.getElementById('accountPanel').classList.remove('open');
    document.getElementById('panelOverlay').classList.remove('open');
}

async function loadAccountData() {
    try {
        const res  = await fetch('/account_data');
        const data = await res.json();

        document.getElementById('panelUsername').textContent = data.username  || '—';
        document.getElementById('panelEmail').textContent    = data.email     || '—';
        document.getElementById('statMoods').textContent     = data.mood_count   ?? '—';
        document.getElementById('statJournals').textContent  = data.journal_count ?? '—';
        document.getElementById('statDays').textContent      = data.days_active  ?? '—';

        if (data.top_mood) {
            document.getElementById('topMoodLabel').textContent =
                `${data.top_mood} (${data.top_mood_pct}% of logs)`;
            document.getElementById('topMoodBar').style.width = data.top_mood_pct + '%';
        }

        buildCalendar(data.calendar || []);
    } catch(e) {
        console.error('Account data error:', e);
    }
}

const MOOD_COLORS = {
    happy:'cal-happy', sad:'cal-sad', angry:'cal-angry',
    anxious:'cal-anxious', calm:'cal-calm', stressed:'cal-stressed',
    tired:'cal-tired', Fear:'cal-fear', swings:'cal-swings'
};

function buildCalendar(calData) {
    const cal     = document.getElementById('moodCalendar');
    cal.innerHTML = '';

    // Build a map of date → mood
    const moodMap = {};
    calData.forEach(d => { moodMap[d.date] = d.mood; });

    // Last 28 days
    const today  = new Date();
    const start  = new Date(today);
    start.setDate(today.getDate() - 27);

    // Pad to Sunday
    const startDay = start.getDay(); // 0=Sun
    for (let p = 0; p < startDay; p++) {
        const blank = document.createElement('div');
        blank.className = 'cal-day';
        cal.appendChild(blank);
    }

    for (let i = 0; i < 28; i++) {
        const d    = new Date(start);
        d.setDate(start.getDate() + i);
        const key  = d.toISOString().split('T')[0];
        const mood = moodMap[key];
        const div  = document.createElement('div');
        div.className = 'cal-day ' + (mood ? (MOOD_COLORS[mood] || 'cal-none') : 'cal-none');
        div.textContent = d.getDate();
        if (mood) {
            div.classList.add('has-mood');
            div.dataset.mood = mood;
            div.title = mood;
        }
        cal.appendChild(div);
    }
}
</script>
</body>
</html>